# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API URL (backend Next.js) — também aceita EXPO_PUBLIC_APP_API_URL
# Produção:
EXPO_PUBLIC_API_URL=https://maidrive.com.br
# Dev na mesma máquina (emulador Android usa 10.0.2.2 automaticamente):
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Maps (opcional - para navegação)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
