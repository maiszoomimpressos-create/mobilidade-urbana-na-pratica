{
  "expo": {
    "name": "Mai Drive Motorista",
    "slug": "driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "maidrive-driver",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maidrive.driver"
    },
    "android": {
      "package": "com.maidrive.driver",
      "adaptiveIcon": {
        "backgroundColor": "#ebb000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O app usa sua localização para mostrar corridas próximas e navegar até os passageiros.",
          "locationAlwaysPermission": "O app usa sua localização em segundo plano para manter você conectado às corridas.",
          "locationWhenInUsePermission": "O app usa sua localização para mostrar corridas próximas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
