# Supabase (mesmo projeto do site) - obrigatório para login/cadastro no app
# Pegue em: Supabase Dashboard → Settings → API
# Para login anônimo ("Continuar sem conta"), habilite em: Auth → Providers → Anonymous sign-ins
EXPO_PUBLIC_SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-aqui"

# URL da API do site (para buscar branding white label do tenant)
# Ex.: https://mobilidade-urbana-na-pratica.vercel.app
EXPO_PUBLIC_APP_API_URL="https://seu-dominio.vercel.app"

# Google Maps (Android) - para o mapa aparecer no app
# Crie em: Google Cloud Console → APIs & Services → Credentials → Create API Key
# Habilite "Maps SDK for Android". Em builds de desenvolvimento (ex.: npx expo run:android) o mapa usa esta chave.
# No Expo Go o mapa pode ficar em branco; use um development build para testar o mapa.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="sua-chave-google-maps-android"
